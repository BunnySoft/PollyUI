+static void rounding_sample(struct wlr_scene_buffer *buffer, int x, int y, void *data) {
+	(void)x;
+	(void)y;
+	struct wlr_scene_output *output = data;
+	struct wlr_scene_output_sample_event event = { .output = output };
+	wl_signal_emit_mutable(&buffer->events.output_sample, &event);
+	if (output->dmabuf_feedback_debounce == 0 && buffer->primary_output == output) {
+		struct wlr_linux_dmabuf_feedback_v1_init_options options = {
+			.main_renderer = output->output->renderer,
+		};
+		scene_buffer_send_dmabuf_feedback(output->scene, buffer, &options);
+	}
+}
