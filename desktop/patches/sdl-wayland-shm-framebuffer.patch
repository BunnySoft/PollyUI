+bool Wayland_CreateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window,
+                                     SDL_PixelFormat *format, void **pixels, int *pitch)
+{
+    SDL_WindowData *data = window->internal;
+    int w = data->current.pixel_width > 0 ? data->current.pixel_width : window->w;
+    int h = data->current.pixel_height > 0 ? data->current.pixel_height : window->h;
+    if (w <= 0 || h <= 0) {
+        SDL_SetError("Invalid Wayland framebuffer size");
+        return false;
+    }
+    Wayland_DestroyWindowFramebuffer(_this, window);
+    data->shm_pool = Wayland_AllocSHMPool(w * h * 4);
+    if (!data->shm_pool) return false;
+    data->shm_buffer = Wayland_AllocBufferFromPool(data->shm_pool, w, h, &data->shm_pixels);
+    if (!data->shm_buffer) {
+        Wayland_ReleaseSHMPool(data->shm_pool);
+        data->shm_pool = NULL;
+        return false;
+    }
+    data->shm_width = w;
+    data->shm_height = h;
+    *format = SDL_PIXELFORMAT_ARGB8888;
+    *pixels = data->shm_pixels;
+    *pitch = w * 4;
+    return true;
+}
+
+bool Wayland_UpdateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window,
+                                     const SDL_Rect *rects, int numrects)
+{
+    SDL_WindowData *data = window->internal;
+    if (!data->shm_buffer || !data->surface) return false;
+    wl_surface_attach(data->surface, data->shm_buffer, 0, 0);
+    for (int i = 0; i < numrects; i++) {
+        const SDL_Rect *r = &rects[i];
+        if (r->w > 0 && r->h > 0)
+            wl_surface_damage_buffer(data->surface, r->x, r->y, r->w, r->h);
+    }
+    wl_surface_commit(data->surface);
+    return true;
+}
+
+void Wayland_DestroyWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_WindowData *data = window->internal;
+    if (data->shm_buffer) {
+        wl_buffer_destroy(data->shm_buffer);
+        data->shm_buffer = NULL;
+    }
+    if (data->shm_pool) {
+        Wayland_ReleaseSHMPool(data->shm_pool);
+        data->shm_pool = NULL;
+    }
+    data->shm_pixels = NULL;
+    data->shm_width = data->shm_height = 0;
+}
