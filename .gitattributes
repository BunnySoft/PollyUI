# Normalize line endings: LF in the repo for source, native on checkout.
* text=auto eol=lf

# Windows-native scripts stay CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unified-diff context prefixes include tab indentation and blank context lines.
desktop/patches/*.patch whitespace=-space-before-tab,-blank-at-eol

# Treat known binaries as binary (no EOL munging).
*.png binary
*.jpg binary
*.ico binary
*.lib binary
*.dll binary
*.a   binary
