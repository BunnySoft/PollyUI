file(MAKE_DIRECTORY "${DEST}" "${DEST}/unrelated-cwd")
get_filename_component(name "${EXE}" NAME)
get_filename_component(provider_name "${PROVIDER}" NAME)
file(COPY_FILE "${EXE}" "${DEST}/${name}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${PROVIDER}" "${DEST}/${provider_name}" ONLY_IF_DIFFERENT)
if(WIN32 AND DXC_DIR)
    foreach(dll IN ITEMS dxcompiler.dll dxil.dll)
        file(COPY_FILE "${DXC_DIR}/${dll}" "${DEST}/${dll}" ONLY_IF_DIFFERENT)
    endforeach()
endif()
execute_process(COMMAND "${DEST}/${name}" "${FIXTURE}" WORKING_DIRECTORY "${DEST}/unrelated-cwd"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
message("${output}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Relocated executable/provider runtime regression failed: ${result}")
endif()
