[Desktop Entry]
Type=Application
Name=File Text
X-Polly-AppId=org.pollyui.file-text
Icon=@CMAKE_INSTALL_FULL_DATADIR@/icons/hicolor/64x64/apps/polly-file-text.png
Comment=Read one literal local text document
Exec=/usr/bin/polly-file-text --file %f
TryExec=/usr/bin/polly-file-text
Terminal=false
NoDisplay=true
MimeType=text/plain;text/markdown;
