#!/bin/sh
# Sourced by bootstrap and the root-only system helper; paths follow moved mounts.
control_error() {
    printf 'Polly Live ERROR: %s\n' "$*" >&2
    if [ -n "${log_directory:-}" ] && [ -d "$log_directory" ]; then
        if ! printf 'Polly Live ERROR: %s\n' "$*" >>"$log_directory/early-boot.log"; then
            printf 'Polly Live ERROR: cannot retain the boot-display cleanup log.\n' >&2
        fi
    fi
}

control_process() {
    case "$control_pid" in ''|*[!0-9]*) return 2 ;; esac
    [ "${#control_pid}" -le 10 ] && [ "$control_pid" -gt 1 ] || return 2
    [ -d "$proc_directory/$control_pid" ] || return 1
    if ! read -r control_stat <"$proc_directory/$control_pid/stat"; then return 2; fi
    control_rest=${control_stat##*) }
    set -- $control_rest
    [ "$#" -ge 20 ] || return 2
    control_state=$1
    shift 19
    control_start=$1
    case "$control_state" in Z|X) return 1 ;; esac
    if [ -n "$control_expected" ] && [ "$control_start" != "$control_expected" ]; then return 2; fi
    [ "$(stat -c %u "$proc_directory/$control_pid")" = 0 ] || return 2
    if ! control_exe=$(readlink "$proc_directory/$control_pid/exe"); then return 2; fi
    case "$control_exe" in */plymouthd|*"/plymouthd (deleted)") return 0 ;; *) return 2 ;; esac
}

control_record() {
    [ "$(id -u)" = 0 ] || { control_error "boot-display control requires root"; return 1; }
    if [ -L "$splash_runtime/pid" ] || [ "$(stat -c %u "$splash_runtime/pid")" != 0 ]; then
        control_error "untrusted boot-display PID file"
        return 1
    fi
    if ! read -r control_pid <"$splash_runtime/pid"; then return 1; fi
    control_expected=
    if ! control_process; then
        control_error "boot-display PID is absent, protected, or has the wrong executable"
        return 1
    fi
    if [ -L "$splash_runtime/polly-owned" ]; then
        control_error "linked boot-display ownership receipt"
        return 1
    fi
    (umask 077; printf '%s %s\n' "$control_pid" "$control_start" >"$splash_runtime/polly-owned")
}

control_load() {
    [ "$(id -u)" = 0 ] || { control_error "boot-display control requires root"; return 1; }
    if [ ! -e "$splash_runtime/polly-owned" ]; then
        [ ! -e "$splash_runtime/pid" ] && return 1
        control_record || return 2
    fi
    if [ -L "$splash_runtime/polly-owned" ] ||
            [ "$(stat -c %u "$splash_runtime/polly-owned")" != 0 ]; then return 2; fi
    if ! read -r control_pid control_expected <"$splash_runtime/polly-owned"; then return 2; fi
    case "$control_expected" in ''|*[!0-9]*) return 2 ;; esac
    if control_process; then return 0; else return "$?"; fi
}

control_wait() {
    control_tick=0
    control_unknown=0
    while [ "$control_tick" -lt 5 ]; do
        if control_process; then
            control_unknown=0
        else
            control_status=$?
            [ "$control_status" = 1 ] && return 0
            control_unknown=1
        fi
        sleep 0.05
        control_tick=$((control_tick + 1))
    done
    if [ "$control_unknown" = 1 ]; then
        control_error "boot-display PID identity is unconfirmed; refusing to signal it"
        return 2
    fi
    return 1
}

control_signal() {
    if control_process; then
        if kill "-$1" "$control_pid"; then return 0; fi
        if control_process; then
            control_error "cannot signal the owned boot display"
            return 1
        else
            [ "$?" = 1 ] && return 0
        fi
    else
        [ "$?" = 1 ] && return 0
    fi
    control_error "refusing to signal an unconfirmed boot-display PID"
    return 1
}

control_release() {
    if control_load; then
        :
    else
        control_status=$?
        if [ "$control_status" = 1 ]; then return 0; fi
        control_error "cannot confirm boot-display ownership; cleanup stopped"
        return 1
    fi
    if ! timeout 1 plymouth quit "$@"; then
        control_error "boot-display IPC failed/expired; checking process exit"
    fi
    if control_wait; then
        rm -f "$splash_runtime/polly-owned"
        return 0
    else
        [ "$?" = 1 ] || return 1
    fi
    control_error "terminating the owned unresponsive boot display"
    control_signal TERM || return 1
    if control_wait; then
        rm -f "$splash_runtime/polly-owned"
        return 0
    else
        [ "$?" = 1 ] || return 1
    fi
    control_error "boot display ignored TERM; forcing only its confirmed PID"
    control_signal KILL || return 1
    if control_wait; then
        control_error "forced daemon exit confirmed; VT text-mode restoration is not established"
        rm -f "$splash_runtime/polly-owned"
        return 0
    fi
    control_error "boot display has not exited; DRM/input release is unconfirmed"
    return 1
}
