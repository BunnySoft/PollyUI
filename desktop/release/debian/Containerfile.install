ARG PLATFORM_IMAGE=localhost/polly-debian-platform-base
ARG SDK_IMAGE=localhost/polly-debian-sdk-mesa:polly1
FROM ${SDK_IMAGE} AS account-tools
COPY release/install/passwd-proxy.c /tmp/passwd-proxy.c
RUN cc -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
    -o /tmp/polly-passwd /tmp/passwd-proxy.c
FROM ${PLATFORM_IMAGE}
USER root
COPY release/debian/account-profile /tmp/polly-account-profile
COPY release/install/roles.py /usr/lib/polly-account-roles.py
COPY session/greeter-entry session/greetd-launch.py session/setup-broker.py session/greetd.conf session/greeter-dependencies.json /usr/lib/pollyui/
COPY session/greeter.mjs session/greeter-controller.mjs /usr/share/pollyui/desktop/session/
COPY session/polly-greetd.pam /etc/pam.d/polly-greetd
COPY session/polly-greetd-greeter.pam /etc/pam.d/polly-greetd-greeter
COPY session/polly-greetd.service session/polly-greeter-setup.service session/polly-greeter-setup.socket /etc/systemd/system/
COPY --from=account-tools /tmp/polly-passwd /usr/lib/polly-passwd
RUN sed -i 's/\r$//' /tmp/polly-account-profile && \
    sh /tmp/polly-account-profile installed && rm /tmp/polly-account-profile && \
    sed -i 's/\r$//' /usr/lib/polly-account-roles.py && chmod 644 /usr/lib/polly-account-roles.py && \
    apt-get update -qq && apt-get install -y --no-install-recommends \
        e2fsprogs python3 libnss-extrausers greetd=0.10.3-4 \
        libpam0g libpam-modules libpam-systemd libsystemd0 && \
    test "$(dpkg-query -W -f='${Version}' greetd)" = 0.10.3-4 && \
    groupadd --system polly-greeter && \
    useradd --system --gid polly-greeter --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin polly-greeter && \
    test "$(id -u polly-greeter)" -gt 0 && test "$(id -u polly-greeter)" -lt 1000 && \
    test "$(id -Gn polly-greeter)" = polly-greeter && \
    sed -i 's/\r$//' /usr/lib/pollyui/greeter-entry /usr/lib/pollyui/greetd-launch.py \
        /usr/lib/pollyui/setup-broker.py /usr/lib/pollyui/greetd.conf \
        /usr/lib/pollyui/greeter-dependencies.json /usr/share/pollyui/desktop/session/greeter*.mjs \
        /etc/pam.d/polly-greetd /etc/pam.d/polly-greetd-greeter \
        /etc/systemd/system/polly-greetd.service /etc/systemd/system/polly-greeter-setup.* && \
    chown 0:0 /usr/lib/pollyui/greeter-entry /usr/lib/pollyui/greetd-launch.py \
        /usr/lib/pollyui/setup-broker.py /usr/lib/pollyui/greetd.conf /usr/lib/pollyui/greeter-dependencies.json \
        /etc/pam.d/polly-greetd /etc/pam.d/polly-greetd-greeter \
        /etc/systemd/system/polly-greetd.service /etc/systemd/system/polly-greeter-setup.* && \
    chmod 755 /usr/lib/pollyui/greeter-entry && \
    chmod 644 /usr/lib/pollyui/greetd-launch.py /usr/lib/pollyui/setup-broker.py \
        /usr/lib/pollyui/greetd.conf /usr/lib/pollyui/greeter-dependencies.json \
        /usr/share/pollyui/desktop/session/greeter*.mjs /etc/pam.d/polly-greetd /etc/pam.d/polly-greetd-greeter \
        /etc/systemd/system/polly-greetd.service /etc/systemd/system/polly-greeter-setup.* && \
    systemctl mask greetd.service && \
    dpkg-divert --local --rename --add /usr/bin/passwd && \
    dpkg-statoverride --add --update root root 0755 /usr/bin/passwd.distrib && \
    install -o root -g root -m 4755 /usr/lib/polly-passwd /usr/bin/passwd && \
    rm /usr/lib/polly-passwd && \
    systemctl mask e2scrub_all.timer e2scrub_all.service e2scrub_reap.service && \
    printf 'RESUME=none\nFSTYPE=ext4\n' > /etc/initramfs-tools/conf.d/polly-install && \
    update-initramfs -u -k all && \
    dpkg-query -W -f='${binary:Package}\t${Version}\t${Homepage}\n' > /usr/share/polly-installed-packages.tsv && \
    apt-get clean && rm -f /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin && \
    rm -rf /var/lib/apt/lists && mkdir -p /var/lib/apt/lists/partial
ENTRYPOINT []
CMD ["/bin/sh"]
