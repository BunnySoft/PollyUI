#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/home/polly USER=polly LOGNAME=polly SHELL=/bin/sh
export LIBSEAT_BACKEND=logind WLR_BACKENDS=drm,libinput
export WLR_RENDERER=pixman
export PU_RENDERER=raster SDL_RENDER_DRIVER=software
unset DISPLAY WAYLAND_DISPLAY WAYLAND_SOCKET DBUS_SESSION_BUS_ADDRESS
if [ "$(id -u)" != 1000 ] || [ "${XDG_RUNTIME_DIR:-}" != /run/user/1000 ] ||
    [ ! -d "$XDG_RUNTIME_DIR" ] || [ -z "${XDG_SESSION_ID:-}" ]; then
    echo "PollyDesktop Live requires its unprivileged live user and private runtime" >&2
    exit 1
fi
cd "$HOME"
logger -t polly-live "Starting ordinary user desktop, uid=$(id -u), tty=$(tty)"
loginctl show-session "$XDG_SESSION_ID" --property=Active --property=User --property=Seat | logger -t polly-login
logger -t polly-live "POLLY_SESSION_REGISTERED uid=$(id -u) id=$XDG_SESSION_ID"
for capability in CanPowerOff CanReboot; do
    if value=$(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager "$capability"); then
        logger -t polly-live "POLLY_POWER_CAPABILITY $capability=$value"
    else
        logger -t polly-live "POLLY_POWER_CAPABILITY $capability=unavailable"
    fi
done
{
    if sh /usr/share/pollyui/desktop/tools/run-session.sh --ime --audio \
        /usr/bin/pollywm /usr/bin/pollyui /usr/share/pollyui/desktop/shell/live.mjs; then
        echo "PollyDesktop session exited normally."
    else
        result=$?
        echo "PollyDesktop session failed with status $result."
    fi
} 2>&1 | logger -t polly-session
echo "Live desktop ended. This shell is temporary; there is no disk installer."
exec /bin/sh
