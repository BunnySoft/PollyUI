{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "win-clang",
      "displayName": "Windows — clang-cl + Ninja + lld (console/dev)",
      "description": "Uses LLVM clang-cl with the installed MSVC SDK. Run inside the MSVC env (tools/build.ps1 sets it up).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "win-clang-windowed",
      "displayName": "Windows — GUI build (no console window)",
      "inherits": "win-clang",
      "binaryDir": "${sourceDir}/build/win-windowed",
      "cacheVariables": { "PU_WINDOWED": "ON" }
    },
    {
      "name": "mac-sdl-metal",
      "displayName": "macOS — SDL3 host + Metal (Skia Ganesh)",
      "description": "Builds the SDL3 host with the Apple Metal render backend. Set SKIA_LIB_DIR to a Metal-enabled macOS Skia (out/Release with libskia.a).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-sdl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PU_HOST": "sdl"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "win-clang", "configurePreset": "win-clang" },
    { "name": "win-clang-windowed", "configurePreset": "win-clang-windowed" },
    { "name": "mac-sdl-metal", "configurePreset": "mac-sdl-metal" }
  ]
}
