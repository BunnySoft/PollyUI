FROM docker.io/library/alpine:3.24 AS compositor-base

RUN apk add --no-cache \
    build-base cmake ninja pkgconf clang compiler-rt gdb valgrind \
    wlroots0.19-dev wlroots0.19-dbg wayland-dev wayland-protocols libxkbcommon-dev \
    xkeyboard-config capitaine-cursors \
    foot font-dejavu

WORKDIR /workspace

FROM compositor-base AS compositor

RUN apk add --no-cache wlr-protocols fontconfig-dev freetype-dev

FROM compositor-base AS runtime

RUN apk add --no-cache \
    git python3 gn clang18 sdl3-dev fontconfig-dev freetype-dev \
    libpng-dev libjpeg-turbo-dev libwebp-dev zlib-dev \
    font-noto-cjk font-noto-emoji

COPY tools/build-skia-linux.sh tools/skia-linux.gn /opt/pollyui-build/
RUN sh /opt/pollyui-build/build-skia-linux.sh /opt/pollyui-skia

RUN apk add --no-cache bash mesa-egl mesa-gles mesa-dri-gallium py3-pillow curl-dev openssl nodejs wlr-protocols

RUN apk add --no-cache librime-dev rime-plum-data

RUN apk add --no-cache mesa-dev libxcursor-dev libxrandr-dev libxfixes-dev libxi-dev libxscrnsaver-dev libxtst-dev alsa-lib-dev
COPY tools/build-sdl-linux.sh /opt/pollyui-build/tools/
COPY patches/sdl-wayland-sync-lifetime.patch /opt/pollyui-build/patches/
RUN sh /opt/pollyui-build/tools/build-sdl-linux.sh /opt/pollyui-sdl

RUN apk add --no-cache meson icu-dev font-noto-arabic font-noto-devanagari
COPY tools/build-harfbuzz-linux.sh /opt/pollyui-build/tools/
RUN sh /opt/pollyui-build/tools/build-harfbuzz-linux.sh /opt/pollyui-harfbuzz
ENV PKG_CONFIG_PATH=/opt/pollyui-text/lib/pkgconfig

RUN apk add --no-cache dbus dbus-dev

RUN apk add --no-cache pipewire pipewire-dev pipewire-tools

RUN apk add --no-cache linux-pam-dev
