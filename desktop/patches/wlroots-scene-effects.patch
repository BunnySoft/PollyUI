+static void rounding_output_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct scene_rounding_cache *cache = wl_container_of(listener, cache, output_destroy);
+	rounding_cache_destroy(cache);
+}
+
+static struct scene_rounding_cache *rounding_find_cache(
+		struct wlr_scene_rounding *rounding, struct wlr_scene_output *output) {
+	struct scene_rounding_cache *cache;
+	wl_list_for_each(cache, &rounding->caches, link) {
+		if (cache->output == output) {
+			return cache;
+		}
+	}
+	return NULL;
+}
+
+static void rounding_render_children(struct wlr_scene_node *node, int x, int y,
+		const struct render_data *data) {
+	if (!node->enabled) {
+		return;
+	}
+	x += node->x;
+	y += node->y;
+	if (node->type == WLR_SCENE_NODE_TREE) {
+		struct wlr_scene_tree *tree = wlr_scene_tree_from_node(node);
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &tree->children, link) {
+			rounding_render_children(child, x, y, data);
+		}
+	} else {
+		struct render_list_entry entry = { .node = node, .x = x, .y = y };
+		scene_entry_render(&entry, data);
+	}
+}
+
+static bool rounding_prepare(struct render_list_entry *entry, const struct render_data *data) {
+	struct wlr_scene_tree *tree = wlr_scene_tree_from_node(entry->node);
+	struct wlr_scene_rounding *rounding = tree->rounding;
+	struct wlr_scene *scene = data->output->scene;
+	struct wlr_output *output = data->output->output;
+	if (!wlr_renderer_is_pixman(output->renderer)
+#if WLR_HAS_GLES2_RENDERER
+			&& !wlr_renderer_is_gles2(output->renderer)
+#endif
+			) {
+		wlr_log(WLR_ERROR, "Scene effects require the patched Pixman or GLES2 renderer");
+		return false;
+	}
+#if WLR_HAS_GLES2_RENDERER
+	if (wlr_renderer_is_gles2(output->renderer) &&
+			!wlr_gles2_renderer_supports_scene_effects(output->renderer)) {
+		wlr_log(WLR_ERROR, "Scene effects require 23-bit fragment highp precision");
+		return false;
+	}
+#endif
+	struct wlr_box physical = {
+		.x = entry->x + rounding->box.x - data->logical.x,
+		.y = entry->y + rounding->box.y - data->logical.y,
+		.width = rounding->box.width, .height = rounding->box.height,
+	};
+	scale_box(&physical, data->scale);
+	if (physical.width <= 0 || physical.height <= 0 ||
+			physical.width > WLR_SCENE_EFFECTS_MAX_AXIS ||
+			physical.height > WLR_SCENE_EFFECTS_MAX_AXIS ||
+			(uint64_t)physical.width * physical.height > WLR_SCENE_EFFECTS_MAX_PIXELS) {
+		wlr_log(WLR_ERROR, "Scene effect target exceeds axis/pixel budget");
+		return false;
+	}
+	/* Reserve RGBA backing plus equally-sized workspace, including A8 stride. */
+	size_t bytes = (size_t)physical.width * physical.height * 8;
+	float phase_x = (entry->x - data->logical.x) * data->scale - physical.x;
+	float phase_y = (entry->y - data->logical.y) * data->scale - physical.y;
+	struct scene_rounding_cache *cache = rounding_find_cache(rounding, data->output);
+	if (cache && (cache->width != physical.width || cache->height != physical.height ||
+			cache->scale != data->scale || cache->phase_x != phase_x || cache->phase_y != phase_y)) {
+		rounding_cache_destroy(cache);
+		cache = NULL;
+	}
+	if (!cache) {
+		if (bytes > WLR_SCENE_EFFECTS_MAX_BYTES - scene->effects_cached_bytes) {
+			wlr_log(WLR_ERROR, "Scene effect aggregate cache/workspace budget exceeded");
+			return false;
+		}
+		cache = calloc(1, sizeof(*cache));
+		if (!cache) {
+			wlr_log(WLR_ERROR, "Cannot allocate scene effect cache");
+			return false;
+		}
+		*cache = (struct scene_rounding_cache) {
+			.rounding = rounding, .output = data->output, .bytes = bytes,
+			.scale = data->scale, .width = physical.width, .height = physical.height,
+			.phase_x = phase_x, .phase_y = phase_y, .dirty = true,
+		};
+		wl_list_insert(&rounding->caches, &cache->link);
+		cache->output_destroy.notify = rounding_output_destroy;
+		wl_signal_add(&data->output->events.destroy, &cache->output_destroy);
+		scene->effects_cached_bytes += bytes;
+		if (scene->effects_cached_bytes > scene->effects_peak_bytes) {
+			scene->effects_peak_bytes = scene->effects_cached_bytes;
+		}
+		const struct wlr_drm_format_set *formats = wlr_renderer_get_render_formats(output->renderer);
+		const struct wlr_drm_format *format = wlr_drm_format_set_get(formats, DRM_FORMAT_ARGB8888);
+		if (format) {
+			cache->buffer = effects_create_buffer(output,
+				physical.width, physical.height, format);
+		}
+		if (!cache->buffer) {
+			wlr_log(WLR_ERROR, "Cannot allocate alpha scene effect render target");
+			rounding_cache_destroy(cache);
+			return false;
+		}
+	}
+	if (!cache->dirty) {
+		return true;
+	}
+	if (cache->texture) {
+		wlr_texture_destroy(cache->texture);
+		cache->texture = NULL;
+	}
+	struct wlr_render_pass *pass = wlr_renderer_begin_buffer_pass(output->renderer, cache->buffer, NULL);
+	if (!pass) {
+		wlr_log(WLR_ERROR, "Cannot begin scene effect pass");
+		rounding_cache_destroy(cache);
+		return false;
+	}
+	wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options) {
+		.box = { .width = physical.width, .height = physical.height },
+		.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+	});
+	bool failed = false;
+	struct render_data isolated = *data;
+	isolated.transform = WL_OUTPUT_TRANSFORM_NORMAL;
+	isolated.render_pass = pass;
+	isolated.isolated = true;
+	isolated.failed = &failed;
+	isolated.buffer_offset_x = physical.x;
+	isolated.buffer_offset_y = physical.y;
+	isolated.trans_width = physical.width;
+	isolated.trans_height = physical.height;
+	pixman_region32_init_rect(&isolated.damage, 0, 0, physical.width, physical.height);
+	struct wlr_scene_node *child;
+	wl_list_for_each(child, &tree->children, link) {
+		rounding_render_children(child, entry->x, entry->y, &isolated);
+	}
+	pixman_region32_fini(&isolated.damage);
+	wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options) {
+		.box = { .width = physical.width, .height = physical.height },
+		.color = { .r = 1, .g = 1, .b = 1, .a = 1 },
+		.blend_mode = WLR_RENDER_BLEND_MODE_DESTINATION_IN,
+		.corner_radius = rounding->radius * data->scale,
+	});
+	if (!wlr_render_pass_submit(pass) || failed) {
+		wlr_log(WLR_ERROR, "Scene effect subtree composition failed");
+		rounding_cache_destroy(cache);
+		return false;
+	}
+	cache->texture = wlr_texture_from_buffer(output->renderer, cache->buffer);
+	if (!cache->texture) {
+		wlr_log(WLR_ERROR, "Cannot import composed scene effect texture");
+		rounding_cache_destroy(cache);
+		return false;
+	}
+	cache->dirty = false;
+	scene->effects_render_count++;
+	return true;
+}
