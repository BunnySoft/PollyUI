+static void backdrop_render_entry(struct render_list_entry *entry, const struct render_data *data) {
+	struct wlr_scene_rect *rect = wlr_scene_rect_from_node(entry->node);
+	struct backdrop_cache *cache = backdrop_find(rect->backdrop, data->output);
+	if (!cache || cache->dirty) {
+		*data->failed = true;
+		return;
+	}
+	pixman_region32_t clip;
+	pixman_region32_init(&clip);
+	if (data->isolated) {
+		pixman_region32_union_rect(&clip, &clip, entry->x, entry->y, rect->width, rect->height);
+	} else {
+		pixman_region32_copy(&clip, &entry->node->visible);
+	}
+	pixman_region32_translate(&clip, -data->logical.x, -data->logical.y);
+	logical_to_buffer_coords(&clip, data, true);
+	pixman_region32_intersect(&clip, &clip, &data->damage);
+	struct wlr_box box = {entry->x - data->logical.x, entry->y - data->logical.y, rect->width, rect->height};
+	transform_output_box(&box, data);
+	wlr_render_pass_add_texture(data->render_pass, &(struct wlr_render_texture_options){
+		.texture = cache->texture, .dst_box = box, .transform = data->transform,
+		.clip = &clip, .blend_mode = WLR_RENDER_BLEND_MODE_PREMULTIPLIED });
+	pixman_region32_fini(&clip);
+}
