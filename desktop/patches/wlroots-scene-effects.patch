+static void snapshot_unaccount(struct scene_snapshot_buffer *snapshot) {
+	if (snapshot->scene) {
+		assert(snapshot->scene->effects_cached_bytes >= snapshot->bytes);
+		snapshot->scene->effects_cached_bytes -= snapshot->bytes;
+		wl_list_remove(&snapshot->scene_destroy.link);
+		snapshot->scene = NULL;
+	}
+}
+
+static void snapshot_scene_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct scene_snapshot_buffer *snapshot = wl_container_of(listener, snapshot, scene_destroy);
+	snapshot_unaccount(snapshot);
+}
+
+static void snapshot_destroy(struct wlr_buffer *buffer) {
+	struct scene_snapshot_buffer *snapshot = wl_container_of(buffer, snapshot, base);
+	snapshot_unaccount(snapshot);
+	if (snapshot->backing) {
+		wlr_buffer_drop(snapshot->backing);
+	}
+	wlr_buffer_finish(buffer);
+	free(snapshot);
+}
+
+static bool snapshot_dmabuf(struct wlr_buffer *buffer, struct wlr_dmabuf_attributes *attrs) {
+	struct scene_snapshot_buffer *snapshot = wl_container_of(buffer, snapshot, base);
+	return wlr_buffer_get_dmabuf(snapshot->backing, attrs);
+}
+
+static bool snapshot_shm(struct wlr_buffer *buffer, struct wlr_shm_attributes *attrs) {
+	struct scene_snapshot_buffer *snapshot = wl_container_of(buffer, snapshot, base);
+	return wlr_buffer_get_shm(snapshot->backing, attrs);
+}
+
+static bool snapshot_begin(struct wlr_buffer *buffer, uint32_t flags,
+		void **data, uint32_t *format, size_t *stride) {
+	struct scene_snapshot_buffer *snapshot = wl_container_of(buffer, snapshot, base);
+	return wlr_buffer_begin_data_ptr_access(snapshot->backing, flags, data, format, stride);
+}
+
+static void snapshot_end(struct wlr_buffer *buffer) {
+	struct scene_snapshot_buffer *snapshot = wl_container_of(buffer, snapshot, base);
+	wlr_buffer_end_data_ptr_access(snapshot->backing);
+}
+
+static const struct wlr_buffer_impl snapshot_impl = {
+	.destroy = snapshot_destroy,
+	.get_dmabuf = snapshot_dmabuf,
+	.get_shm = snapshot_shm,
+	.begin_data_ptr_access = snapshot_begin,
+	.end_data_ptr_access = snapshot_end,
+};
+
+static bool snapshot_tree_valid(struct wlr_scene_tree *tree,
+		int64_t x, int64_t y, unsigned depth, unsigned *count) {
+	if (depth > 64) {
+		return false;
+	}
+	struct wlr_scene_node *child;
+	wl_list_for_each(child, &tree->children, link) {
+		if (!child->enabled) {
+			continue;
+		}
+		int64_t cx = x + child->x, cy = y + child->y;
+		if (++*count > 512 || cx < INT32_MIN || cx > INT32_MAX ||
+				cy < INT32_MIN || cy > INT32_MAX) {
+			return false;
+		}
+		if (child->type == WLR_SCENE_NODE_TREE) {
+			struct wlr_scene_tree *subtree = wlr_scene_tree_from_node(child);
+			if (subtree->rounding || !snapshot_tree_valid(subtree, cx, cy, depth + 1, count)) {
+				return false;
+			}
+		} else if (child->type == WLR_SCENE_NODE_RECT &&
+				wlr_scene_rect_from_node(child)->backdrop) {
+			return false;
+		}
+	}
+	return true;
+}
+
+struct wlr_buffer *wlr_scene_tree_snapshot(struct wlr_scene_tree *tree,
+		struct wlr_scene_output *output, const struct wlr_box *box,
+		float radius, int width, int height) {
+	if (!tree || !output || !box || scene_node_get_root(&tree->node) != output->scene ||
+			width < 1 || height < 1 || width > 1024 || height > 640 ||
+			box->width < 1 || box->height < 1 ||
+			box->width > WLR_SCENE_EFFECTS_MAX_AXIS ||
+			box->height > WLR_SCENE_EFFECTS_MAX_AXIS ||
+			!isfinite(radius) || radius < 0 ||
+			radius > fminf(box->width, box->height) / 2) {
+		wlr_log(WLR_ERROR, "Invalid bounded subtree snapshot request");
+		return NULL;
+	}
+	struct wlr_output *target = output->output;
+	if (!wlr_renderer_is_pixman(target->renderer)
+#if WLR_HAS_GLES2_RENDERER
+			&& !(wlr_renderer_is_gles2(target->renderer) &&
+				wlr_gles2_renderer_supports_scene_effects(target->renderer))
+#endif
+			) {
+		wlr_log(WLR_ERROR, "Subtree snapshots require a paired renderer");
+		return NULL;
+	}
+	int64_t x = 0, y = 0;
+	for (struct wlr_scene_node *node = &tree->node; node; node = node->parent ? &node->parent->node : NULL) {
+		x += node->x;
+		y += node->y;
+	}
+	unsigned nodes = 0;
+	if (x < INT32_MIN || x > INT32_MAX || y < INT32_MIN || y > INT32_MAX ||
+			x + box->x < INT32_MIN || x + box->x > INT32_MAX ||
+			y + box->y < INT32_MIN || y + box->y > INT32_MAX ||
+			!snapshot_tree_valid(tree, x, y, 0, &nodes)) {
+		wlr_log(WLR_ERROR, "Subtree snapshot coordinates overflow");
+		return NULL;
+	}
+	x += box->x;
+	y += box->y;
+	struct wlr_scene *scene = output->scene;
+	size_t bytes = (size_t)width * height * 8;
+	if (bytes > WLR_SCENE_EFFECTS_MAX_BYTES - scene->effects_cached_bytes) {
+		wlr_log(WLR_ERROR, "Subtree snapshot exceeds aggregate backing/workspace budget");
+		return NULL;
+	}
+	const struct wlr_drm_format *format = wlr_drm_format_set_get(
+		wlr_renderer_get_render_formats(target->renderer), DRM_FORMAT_ARGB8888);
+	struct scene_snapshot_buffer *snapshot = calloc(1, sizeof(*snapshot));
+	if (!format || !snapshot) {
+		free(snapshot);
+		wlr_log(WLR_ERROR, "Cannot allocate subtree snapshot state or format");
+		return NULL;
+	}
+	wlr_buffer_init(&snapshot->base, &snapshot_impl, width, height);
+	snapshot->scene = scene;
+	snapshot->bytes = bytes;
+	scene->effects_cached_bytes += bytes;
+	if (scene->effects_cached_bytes > scene->effects_peak_bytes) {
+		scene->effects_peak_bytes = scene->effects_cached_bytes;
+	}
+	snapshot->scene_destroy.notify = snapshot_scene_destroy;
+	wl_signal_add(&scene->tree.node.events.destroy, &snapshot->scene_destroy);
+	snapshot->backing = effects_create_buffer(target, width, height, format);
+	struct wlr_render_pass *pass = snapshot->backing ?
+		wlr_renderer_begin_buffer_pass(target->renderer, snapshot->backing, NULL) : NULL;
+	if (!pass) {
+		wlr_log(WLR_ERROR, "Cannot allocate or begin subtree snapshot");
+		wlr_buffer_drop(&snapshot->base);
+		return NULL;
+	}
+	wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options) {
+		.box = {.width = width, .height = height},
+		.color = {0}, .blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+	});
+	float scale = fminf((float)width / box->width, (float)height / box->height);
+	int fitted_width = fminf(width, fmaxf(1, roundf(box->width * scale)));
+	int fitted_height = fminf(height, fmaxf(1, roundf(box->height * scale)));
+	int pad_x = (width - fitted_width) / 2, pad_y = (height - fitted_height) / 2;
+	bool failed = false;
+	struct render_data data = {
+		.output = output, .render_pass = pass, .scale = scale,
+		.logical = {.x = (int)x, .y = (int)y},
+		.trans_width = width, .trans_height = height,
+		.buffer_offset_x = -pad_x, .buffer_offset_y = -pad_y,
+		.isolated = true, .failed = &failed,
+	};
+	pixman_region32_init_rect(&data.damage, pad_x, pad_y, fitted_width, fitted_height);
+	struct wlr_scene_node *child;
+	wl_list_for_each(child, &tree->children, link) {
+		rounding_render_children(child, (int)(x - box->x), (int)(y - box->y), &data);
+	}
+	pixman_region32_fini(&data.damage);
+	wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options) {
+		.box = {pad_x, pad_y, fitted_width, fitted_height},
+		.color = {1, 1, 1, 1},
+		.blend_mode = WLR_RENDER_BLEND_MODE_DESTINATION_IN,
+		.corner_radius = fminf(radius * scale, fminf(fitted_width, fitted_height) / 2),
+	});
+	if (!wlr_render_pass_submit(pass) || failed) {
+		wlr_log(WLR_ERROR, "Subtree snapshot composition failed");
+		wlr_buffer_drop(&snapshot->base);
+		return NULL;
+	}
+	return &snapshot->base;
+}
+
+bool wlr_scene_projection_supported(struct wlr_renderer *renderer) {
+#if WLR_HAS_GLES2_RENDERER
+	return renderer && wlr_renderer_is_gles2(renderer) &&
+		wlr_gles2_renderer_supports_projection(renderer);
+#else
+	(void)renderer;
+	return false;
+#endif
+}
+
+struct wlr_buffer *wlr_scene_projected_snapshot(struct wlr_scene_output *output,
+		const struct wlr_scene_projected_quad *quads, size_t count,
+		int width, int height, const float background[4]) {
+	if (!output || !quads || !background || count < 1 ||
+			count > WLR_SCENE_PROJECTION_MAX_QUADS || width < 1 || height < 1 ||
+			width > WLR_SCENE_PROJECTION_MAX_WIDTH || height > WLR_SCENE_PROJECTION_MAX_HEIGHT ||
+			!wlr_scene_projection_supported(output->output->renderer)) {
+		wlr_log(WLR_ERROR, "Invalid or unsupported bounded projected snapshot");
+		return NULL;
+	}
+	for (unsigned channel = 0; channel < 4; channel++) {
+		if (!isfinite(background[channel]) || background[channel] < 0 ||
+				background[channel] > (channel == 3 ? 1 : background[3])) {
+			wlr_log(WLR_ERROR, "Projected snapshot background is not premultiplied RGBA");
+			return NULL;
+		}
+	}
+	for (size_t index = 0; index < count; index++) {
+		if (!quads[index].buffer || quads[index].buffer->width < 1 || quads[index].buffer->height < 1 ||
+				quads[index].buffer->width > WLR_SCENE_PROJECTION_MAX_WIDTH ||
+				quads[index].buffer->height > WLR_SCENE_PROJECTION_MAX_HEIGHT) {
+			wlr_log(WLR_ERROR, "Projected snapshot source exceeds bounded dimensions");
+			return NULL;
+		}
+	}
+#if WLR_HAS_GLES2_RENDERER
+	struct wlr_scene *scene = output->scene;
+	size_t bytes = (size_t)width * height * 10;
+	if (bytes > WLR_SCENE_EFFECTS_MAX_BYTES - scene->effects_cached_bytes) {
+		wlr_log(WLR_ERROR, "Projected snapshot exceeds RGBA/depth/workspace peak budget");
+		return NULL;
+	}
+	struct wlr_output *target = output->output;
+	const struct wlr_drm_format *format = wlr_drm_format_set_get(
+		wlr_renderer_get_render_formats(target->renderer), DRM_FORMAT_ARGB8888);
+	struct scene_snapshot_buffer *snapshot = calloc(1, sizeof(*snapshot));
+	if (!format || !snapshot) {
+		free(snapshot);
+		wlr_log(WLR_ERROR, "Cannot allocate projected snapshot state or alpha format");
+		return NULL;
+	}
+	wlr_buffer_init(&snapshot->base, &snapshot_impl, width, height);
+	snapshot->scene = scene;
+	snapshot->bytes = bytes;
+	scene->effects_cached_bytes += bytes;
+	if (scene->effects_cached_bytes > scene->effects_peak_bytes) {
+		scene->effects_peak_bytes = scene->effects_cached_bytes;
+	}
+	snapshot->scene_destroy.notify = snapshot_scene_destroy;
+	wl_signal_add(&scene->tree.node.events.destroy, &snapshot->scene_destroy);
+	snapshot->backing = effects_create_buffer(target, width, height, format);
+	struct wlr_texture *textures[WLR_SCENE_PROJECTION_MAX_QUADS] = {0};
+	bool ready = snapshot->backing != NULL;
+	for (size_t index = 0; index < count && ready; index++) {
+		textures[index] = wlr_texture_from_buffer(target->renderer, quads[index].buffer);
+		ready = textures[index] != NULL;
+	}
+	struct wlr_render_pass *pass = ready ?
+		wlr_renderer_begin_buffer_pass(target->renderer, snapshot->backing, NULL) : NULL;
+	bool rendered = false;
+	if (pass) {
+		wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options){
+			.box = {.width = width, .height = height},
+			.color = {background[0], background[1], background[2], background[3]},
+			.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+		});
+		rendered = true;
+		for (size_t index = 0; index < count && rendered; index++) {
+			struct wlr_gles2_projected_texture_options options = {
+				.texture = textures[index], .opacity = quads[index].opacity,
+			};
+			memcpy(options.vertices, quads[index].vertices, sizeof(options.vertices));
+			memcpy(options.background, quads[index].background, sizeof(options.background));
+			rendered = wlr_gles2_render_pass_add_projected_texture(pass, &options);
+		}
+		bool submitted = wlr_render_pass_submit(pass);
+		rendered = rendered && submitted;
+	}
+	for (size_t index = 0; index < count; index++)
+		if (textures[index]) wlr_texture_destroy(textures[index]);
+	if (!rendered) {
+		wlr_log(WLR_ERROR, "Projected snapshot allocation/import/drawing failed");
+		wlr_buffer_drop(&snapshot->base);
+		return NULL;
+	}
+	return &snapshot->base;
+#else
+	return NULL;
+#endif
+}
+
+static struct backdrop_cache *backdrop_find(struct wlr_scene_backdrop *backdrop,
+		struct wlr_scene_output *output) {
+	struct backdrop_cache *cache;
+	wl_list_for_each(cache, &backdrop->caches, link) {
+		if (cache->output == output) {
+			return cache;
+		}
+	}
+	return NULL;
+}
+
+/* Traverse the scene, not the visibility-culled output list: an upper opaque
+ * node must not erase lower pixels needed by an earlier backdrop's kernel. */
+static bool backdrop_lower(struct wlr_scene_node *node, struct wlr_scene_node *stop,
+		int x, int y, const struct render_data *data) {
+	if (node == stop) {
+		return true;
+	}
+	if (!node->enabled) {
+		/* Hidden ancestors still locate the preflight stop, but contribute no pixels. */
+		for (struct wlr_scene_node *ancestor = stop; ancestor;
+				ancestor = ancestor->parent ? &ancestor->parent->node : NULL) {
+			if (ancestor == node) {
+				return true;
+			}
+		}
+		return false;
+	}
+	x += node->x;
+	y += node->y;
+	struct render_list_entry entry = { .node = node, .x = x, .y = y };
+	if (node->type == WLR_SCENE_NODE_TREE) {
+		struct wlr_scene_tree *tree = wlr_scene_tree_from_node(node);
+		if (tree->rounding) {
+			if (!rounding_prepare(&entry, data)) {
+				*data->failed = true;
+			} else {
+				rounding_render_entry(&entry, data);
+			}
+			return false;
+		}
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &tree->children, link) {
+			if (backdrop_lower(child, stop, x, y, data)) {
+				return true;
+			}
+		}
+	} else {
+		int width, height;
+		scene_node_get_size(node, &width, &height);
+		struct wlr_box box = {x - data->logical.x, y - data->logical.y, width, height};
+		scale_box(&box, data->scale);
+		struct wlr_box region = {data->buffer_offset_x, data->buffer_offset_y,
+			data->trans_width, data->trans_height}, intersection;
+		if (wlr_box_intersection(&intersection, &box, &region)) {
+			if (node->type == WLR_SCENE_NODE_RECT && wlr_scene_rect_from_node(node)->backdrop &&
+					!backdrop_prepare(wlr_scene_rect_from_node(node), data)) {
+				*data->failed = true;
+			} else {
+				scene_entry_render(&entry, data);
+			}
+		}
+	}
+	return false;
+}
+
+#if defined(__x86_64__) && defined(__SSE2__)
+static inline __m128 backdrop_pixel_channels(uint32_t pixel) {
+	int32_t bits;
+	memcpy(&bits, &pixel, sizeof(bits));
+	__m128i bytes = _mm_cvtsi32_si128(bits);
+	__m128i zero = _mm_setzero_si128();
+	__m128i words = _mm_unpacklo_epi8(bytes, zero);
+	return _mm_cvtepi32_ps(_mm_unpacklo_epi16(words, zero));
+}
+
+static inline uint32_t backdrop_pack_channels(__m128 accumulated) {
+	float values[4];
+	_mm_storeu_ps(values, accumulated);
+	uint32_t pixel = (uint32_t)lroundf(values[0]);
+	pixel |= (uint32_t)lroundf(values[1]) << 8;
+	pixel |= (uint32_t)lroundf(values[2]) << 16;
+	pixel |= (uint32_t)lroundf(values[3]) << 24;
+	return pixel;
+}
+
+static inline uint32_t backdrop_finish_channels(__m128 accumulated,
+		const float color[4], float radius, int px, int py, int width, int height) {
+	float qx = fabsf(px + 0.5f - width / 2.0f) - width / 2.0f + radius;
+	float qy = fabsf(py + 0.5f - height / 2.0f) - height / 2.0f + radius;
+	float distance = hypotf(fmaxf(qx, 0), fmaxf(qy, 0)) + fminf(fmaxf(qx, qy), 0) - radius;
+	float coverage = radius == 0 ? 1 : fminf(fmaxf(0.5f - distance, 0), 1);
+	float values[4];
+	_mm_storeu_ps(values, accumulated);
+	values[0] = color[2] * 255 + values[0] * (1 - color[3]);
+	values[1] = color[1] * 255 + values[1] * (1 - color[3]);
+	values[2] = color[0] * 255 + values[2] * (1 - color[3]);
+	values[3] = color[3] * 255 + values[3] * (1 - color[3]);
+	uint32_t pixel = (uint32_t)lroundf(fminf(values[0], 255) * coverage);
+	pixel |= (uint32_t)lroundf(fminf(values[1], 255) * coverage) << 8;
+	pixel |= (uint32_t)lroundf(fminf(values[2], 255) * coverage) << 16;
+	pixel |= (uint32_t)lroundf(fminf(values[3], 255) * coverage) << 24;
+	return pixel;
+}
+struct backdrop_filter_context {
+	void *source, *destination;
+	size_t source_stride, dest_stride;
+	uint32_t *temporary;
+	const float *kernel;
+	int width, height, pad;
+	struct wlr_box physical;
+	float corner_radius, scale;
+	const float *color;
+};
+
+struct backdrop_filter_ops {
+	void (*horizontal)(const struct backdrop_filter_context *filter);
+	void (*vertical)(const struct backdrop_filter_context *filter);
+	const char *name;
+};
+
+static void backdrop_horizontal_production(const struct backdrop_filter_context *filter) {
+	void *source = filter->source;
+	size_t source_stride = filter->source_stride;
+	uint32_t *temporary = filter->temporary;
+	const float *kernel = filter->kernel;
+	int width = filter->width, height = filter->height, pad = filter->pad;
+	for (int py = 0; py < height; py++) {
+		uint32_t *row = (uint32_t *)((uint8_t *)source + py * source_stride);
+		for (int px = pad; px < width - pad; px++) {
+			__m128 accumulated = _mm_setzero_ps();
+			for (int i = -pad; i <= pad; i++) {
+				__m128 channels = backdrop_pixel_channels(row[px + i]);
+				__m128 weighted = _mm_mul_ps(channels, _mm_set1_ps(kernel[i + pad]));
+				accumulated = _mm_add_ps(accumulated, weighted);
+			}
+			float values[4];
+			_mm_storeu_ps(values, accumulated);
+			uint32_t pixel = (uint32_t)lroundf(values[0]);
+			pixel |= (uint32_t)lroundf(values[1]) << 8;
+			pixel |= (uint32_t)lroundf(values[2]) << 16;
+			pixel |= (uint32_t)lroundf(values[3]) << 24;
+			temporary[py * width + px] = pixel;
+		}
+	}
+}
+
+static void backdrop_vertical_production(const struct backdrop_filter_context *filter) {
+	void *destination = filter->destination;
+	size_t dest_stride = filter->dest_stride;
+	uint32_t *temporary = filter->temporary;
+	const float *kernel = filter->kernel;
+	int width = filter->width, pad = filter->pad;
+	struct wlr_box physical = filter->physical;
+	for (int py = 0; py < physical.height; py++) {
+		uint32_t *row = (uint32_t *)((uint8_t *)destination + py * dest_stride);
+		for (int px = 0; px < physical.width; px++) {
+			float radius = filter->corner_radius * filter->scale;
+			float qx = fabsf(px + 0.5f - physical.width / 2.0f) - physical.width / 2.0f + radius;
+			float qy = fabsf(py + 0.5f - physical.height / 2.0f) - physical.height / 2.0f + radius;
+			float distance = hypotf(fmaxf(qx, 0), fmaxf(qy, 0)) + fminf(fmaxf(qx, qy), 0) - radius;
+			float coverage = radius == 0 ? 1 : fminf(fmaxf(0.5f - distance, 0), 1);
+			__m128 accumulated = _mm_setzero_ps();
+			for (int i = -pad; i <= pad; i++) {
+				__m128 channels = backdrop_pixel_channels(
+					temporary[(py + pad + i) * width + px + pad]);
+				__m128 weighted = _mm_mul_ps(channels, _mm_set1_ps(kernel[i + pad]));
+				accumulated = _mm_add_ps(accumulated, weighted);
+			}
+			float values[4];
+			_mm_storeu_ps(values, accumulated);
+			values[0] = filter->color[2] * 255 + values[0] * (1 - filter->color[3]);
+			values[1] = filter->color[1] * 255 + values[1] * (1 - filter->color[3]);
+			values[2] = filter->color[0] * 255 + values[2] * (1 - filter->color[3]);
+			values[3] = filter->color[3] * 255 + values[3] * (1 - filter->color[3]);
+			uint32_t pixel = (uint32_t)lroundf(fminf(values[0], 255) * coverage);
+			pixel |= (uint32_t)lroundf(fminf(values[1], 255) * coverage) << 8;
+			pixel |= (uint32_t)lroundf(fminf(values[2], 255) * coverage) << 16;
+			pixel |= (uint32_t)lroundf(fminf(values[3], 255) * coverage) << 24;
+			row[px] = pixel;
+		}
+	}
+}
+
+static void backdrop_horizontal_experimental(const struct backdrop_filter_context *filter) {
+	void *source = filter->source;
+	size_t source_stride = filter->source_stride;
+	uint32_t *temporary = filter->temporary;
+	const float *kernel = filter->kernel;
+	int width = filter->width, height = filter->height, pad = filter->pad;
+	for (int py = 0; py < height; py++) {
+		uint32_t *row = (uint32_t *)((uint8_t *)source + py * source_stride);
+		int px = pad;
+		for (; px + 3 < width - pad; px += 4) {
+			__m128 sum0 = _mm_setzero_ps(), sum1 = _mm_setzero_ps();
+			__m128 sum2 = _mm_setzero_ps(), sum3 = _mm_setzero_ps();
+			__m128 channels0 = backdrop_pixel_channels(row[px - pad]);
+			__m128 channels1 = backdrop_pixel_channels(row[px - pad + 1]);
+			__m128 channels2 = backdrop_pixel_channels(row[px - pad + 2]);
+			int i = -pad;
+			for (; i + 3 <= pad; i += 4) {
+				__m128 channels3 = backdrop_pixel_channels(row[px + i + 3]);
+				__m128 weight = _mm_set1_ps(kernel[i + pad]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels0, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels1, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels2, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels3, weight));
+				channels0 = backdrop_pixel_channels(row[px + i + 4]);
+				weight = _mm_set1_ps(kernel[i + pad + 1]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels1, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels2, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels3, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels0, weight));
+				channels1 = backdrop_pixel_channels(row[px + i + 5]);
+				weight = _mm_set1_ps(kernel[i + pad + 2]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels2, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels3, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels0, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels1, weight));
+				channels2 = backdrop_pixel_channels(row[px + i + 6]);
+				weight = _mm_set1_ps(kernel[i + pad + 3]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels3, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels0, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels1, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels2, weight));
+			}
+			for (; i <= pad; i++) {
+				__m128 channels3 = backdrop_pixel_channels(row[px + i + 3]);
+				__m128 weight = _mm_set1_ps(kernel[i + pad]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels0, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels1, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels2, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels3, weight));
+				channels0 = channels1;
+				channels1 = channels2;
+				channels2 = channels3;
+			}
+			temporary[py * width + px] = backdrop_pack_channels(sum0);
+			temporary[py * width + px + 1] = backdrop_pack_channels(sum1);
+			temporary[py * width + px + 2] = backdrop_pack_channels(sum2);
+			temporary[py * width + px + 3] = backdrop_pack_channels(sum3);
+		}
+		for (; px < width - pad; px++) {
+			__m128 accumulated = _mm_setzero_ps();
+			for (int i = -pad; i <= pad; i++) {
+				__m128 channels = backdrop_pixel_channels(row[px + i]);
+				__m128 weighted = _mm_mul_ps(channels, _mm_set1_ps(kernel[i + pad]));
+				accumulated = _mm_add_ps(accumulated, weighted);
+			}
+			float values[4];
+			_mm_storeu_ps(values, accumulated);
+			uint32_t pixel = (uint32_t)lroundf(values[0]);
+			pixel |= (uint32_t)lroundf(values[1]) << 8;
+			pixel |= (uint32_t)lroundf(values[2]) << 16;
+			pixel |= (uint32_t)lroundf(values[3]) << 24;
+			temporary[py * width + px] = pixel;
+		}
+	}
+}
+
+static void backdrop_vertical_experimental(const struct backdrop_filter_context *filter) {
+	void *destination = filter->destination;
+	size_t dest_stride = filter->dest_stride;
+	uint32_t *temporary = filter->temporary;
+	const float *kernel = filter->kernel;
+	int width = filter->width, pad = filter->pad;
+	struct wlr_box physical = filter->physical;
+	int py = 0;
+	for (; py + 3 < physical.height; py += 4) {
+		uint32_t *row0 = (uint32_t *)((uint8_t *)destination + py * dest_stride);
+		uint32_t *row1 = (uint32_t *)((uint8_t *)destination + (py + 1) * dest_stride);
+		uint32_t *row2 = (uint32_t *)((uint8_t *)destination + (py + 2) * dest_stride);
+		uint32_t *row3 = (uint32_t *)((uint8_t *)destination + (py + 3) * dest_stride);
+		for (int px = 0; px < physical.width; px++) {
+			__m128 sum0 = _mm_setzero_ps(), sum1 = _mm_setzero_ps();
+			__m128 sum2 = _mm_setzero_ps(), sum3 = _mm_setzero_ps();
+			__m128 channels0 = backdrop_pixel_channels(temporary[py * width + px + pad]);
+			__m128 channels1 = backdrop_pixel_channels(temporary[(py + 1) * width + px + pad]);
+			__m128 channels2 = backdrop_pixel_channels(temporary[(py + 2) * width + px + pad]);
+			int i = -pad;
+			for (; i + 3 <= pad; i += 4) {
+				__m128 channels3 = backdrop_pixel_channels(
+					temporary[(py + pad + i + 3) * width + px + pad]);
+				__m128 weight = _mm_set1_ps(kernel[i + pad]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels0, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels1, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels2, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels3, weight));
+				channels0 = backdrop_pixel_channels(
+					temporary[(py + pad + i + 4) * width + px + pad]);
+				weight = _mm_set1_ps(kernel[i + pad + 1]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels1, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels2, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels3, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels0, weight));
+				channels1 = backdrop_pixel_channels(
+					temporary[(py + pad + i + 5) * width + px + pad]);
+				weight = _mm_set1_ps(kernel[i + pad + 2]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels2, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels3, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels0, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels1, weight));
+				channels2 = backdrop_pixel_channels(
+					temporary[(py + pad + i + 6) * width + px + pad]);
+				weight = _mm_set1_ps(kernel[i + pad + 3]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels3, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels0, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels1, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels2, weight));
+			}
+			for (; i <= pad; i++) {
+				__m128 channels3 = backdrop_pixel_channels(
+					temporary[(py + pad + i + 3) * width + px + pad]);
+				__m128 weight = _mm_set1_ps(kernel[i + pad]);
+				sum0 = _mm_add_ps(sum0, _mm_mul_ps(channels0, weight));
+				sum1 = _mm_add_ps(sum1, _mm_mul_ps(channels1, weight));
+				sum2 = _mm_add_ps(sum2, _mm_mul_ps(channels2, weight));
+				sum3 = _mm_add_ps(sum3, _mm_mul_ps(channels3, weight));
+				channels0 = channels1;
+				channels1 = channels2;
+				channels2 = channels3;
+			}
+			float radius = filter->corner_radius * filter->scale;
+			row0[px] = backdrop_finish_channels(sum0, filter->color, radius,
+				px, py, physical.width, physical.height);
+			row1[px] = backdrop_finish_channels(sum1, filter->color, radius,
+				px, py + 1, physical.width, physical.height);
+			row2[px] = backdrop_finish_channels(sum2, filter->color, radius,
+				px, py + 2, physical.width, physical.height);
+			row3[px] = backdrop_finish_channels(sum3, filter->color, radius,
+				px, py + 3, physical.width, physical.height);
+		}
+	}
+	for (; py < physical.height; py++) {
+		uint32_t *row = (uint32_t *)((uint8_t *)destination + py * dest_stride);
+		for (int px = 0; px < physical.width; px++) {
+			float radius = filter->corner_radius * filter->scale;
+			float qx = fabsf(px + 0.5f - physical.width / 2.0f) - physical.width / 2.0f + radius;
+			float qy = fabsf(py + 0.5f - physical.height / 2.0f) - physical.height / 2.0f + radius;
+			float distance = hypotf(fmaxf(qx, 0), fmaxf(qy, 0)) + fminf(fmaxf(qx, qy), 0) - radius;
+			float coverage = radius == 0 ? 1 : fminf(fmaxf(0.5f - distance, 0), 1);
+			__m128 accumulated = _mm_setzero_ps();
+			for (int i = -pad; i <= pad; i++) {
+				__m128 channels = backdrop_pixel_channels(
+					temporary[(py + pad + i) * width + px + pad]);
+				__m128 weighted = _mm_mul_ps(channels, _mm_set1_ps(kernel[i + pad]));
+				accumulated = _mm_add_ps(accumulated, weighted);
+			}
+			float values[4];
+			_mm_storeu_ps(values, accumulated);
+			values[0] = filter->color[2] * 255 + values[0] * (1 - filter->color[3]);
+			values[1] = filter->color[1] * 255 + values[1] * (1 - filter->color[3]);
+			values[2] = filter->color[0] * 255 + values[2] * (1 - filter->color[3]);
+			values[3] = filter->color[3] * 255 + values[3] * (1 - filter->color[3]);
+			uint32_t pixel = (uint32_t)lroundf(fminf(values[0], 255) * coverage);
+			pixel |= (uint32_t)lroundf(fminf(values[1], 255) * coverage) << 8;
+			pixel |= (uint32_t)lroundf(fminf(values[2], 255) * coverage) << 16;
+			pixel |= (uint32_t)lroundf(fminf(values[3], 255) * coverage) << 24;
+			row[px] = pixel;
+		}
+	}
+}
+
+static const struct backdrop_filter_ops backdrop_production_ops = {
+	.horizontal = backdrop_horizontal_production,
+	.vertical = backdrop_vertical_production,
+	.name = "production-single-output",
+};
+
+static const struct backdrop_filter_ops backdrop_experimental_ops = {
+	.horizontal = backdrop_horizontal_experimental,
+	.vertical = backdrop_vertical_experimental,
+	.name = "experimental-four-phase",
+};
+
+#endif
+
+#if WLR_HAS_GLES2_RENDERER
+static bool backdrop_gles2_filter(struct wlr_output *output, struct wlr_buffer *sample,
+		struct wlr_buffer *destination, const struct wlr_drm_format *format,
+		int width, int height, int pad, const float *kernel, float radius, const float tint[static 4]) {
+	struct wlr_buffer *middle = effects_create_buffer(output, width, height, format);
+	struct wlr_texture *source = middle ? wlr_texture_from_buffer(output->renderer, sample) : NULL;
+	struct wlr_render_pass *pass = source ?
+		wlr_renderer_begin_buffer_pass(output->renderer, middle, NULL) : NULL;
+	bool ok = false;
+	if (pass) {
+		struct wlr_gles2_blur_options options = {
+			.texture = source, .kernel = kernel, .kernel_size = (uint32_t)(2 * pad + 1),
+			.source = {.width = width, .height = height},
+		};
+		bool filtered = wlr_gles2_render_pass_blur(pass, &options);
+		bool submitted = wlr_render_pass_submit(pass);
+		ok = filtered && submitted;
+	}
+	if (source) wlr_texture_destroy(source);
+	source = ok ? wlr_texture_from_buffer(output->renderer, middle) : NULL;
+	pass = source ? wlr_renderer_begin_buffer_pass(output->renderer, destination, NULL) : NULL;
+	ok = false;
+	if (pass) {
+		struct wlr_gles2_blur_options options = {
+			.texture = source, .kernel = kernel, .kernel_size = (uint32_t)(2 * pad + 1),
+			.source = {pad, pad, destination->width, destination->height},
+			.vertical = true, .corner_radius = radius,
+		};
+		memcpy(options.tint, tint, sizeof(options.tint));
+		bool filtered = wlr_gles2_render_pass_blur(pass, &options);
+		bool submitted = wlr_render_pass_submit(pass);
+		ok = filtered && submitted;
+	}
+	if (source) wlr_texture_destroy(source);
+	if (middle) wlr_buffer_drop(middle);
+	return ok;
+}
+#endif
+
+static bool backdrop_prepare(struct wlr_scene_rect *rect, const struct render_data *data) {
+	struct wlr_scene_backdrop *backdrop = rect->backdrop;
+	struct wlr_scene *scene = backdrop->scene;
+	struct wlr_output *output = data->output->output;
+	int x, y;
+	wlr_scene_node_coords(&rect->node, &x, &y);
+	struct wlr_box physical = {x - data->logical.x, y - data->logical.y, rect->width, rect->height};
+	scale_box(&physical, data->scale);
+	float phase_x = (x - data->logical.x) * data->scale - physical.x;
+	float phase_y = (y - data->logical.y) * data->scale - physical.y;
+	struct backdrop_cache *old = backdrop_find(backdrop, data->output);
+	if (old && !old->dirty && old->scale == data->scale &&
+			old->phase_x == phase_x && old->phase_y == phase_y && wlr_box_equal(&physical, &old->physical)) {
+		return true;
+	}
+	float sigma = backdrop->sigma * data->scale;
+	int pad = ceilf(3 * sigma);
+	int width = physical.width + pad * 2, height = physical.height + pad * 2;
+	if (!wlr_scene_backdrop_supported(output->renderer) || !isfinite(sigma) || sigma > WLR_SCENE_BACKDROP_MAX_SCALED_SIGMA ||
+			physical.width <= 0 || physical.height <= 0 ||
+			width > WLR_SCENE_EFFECTS_MAX_AXIS || height > WLR_SCENE_EFFECTS_MAX_AXIS ||
+			(uint64_t)width * height > WLR_SCENE_BACKDROP_MAX_PIXELS) {
+		wlr_log(WLR_ERROR, "Unsupported backdrop renderer/scale or regional pixel budget");
+		return false;
+	}
+	bool gles2 = !wlr_renderer_is_pixman(output->renderer);
+	size_t bytes = (size_t)width * height * 8 +
+		(size_t)physical.width * physical.height * 8 + sizeof(float) * (2 * pad + 1) * (gles2 ? 3 : 1);
+	if (bytes > WLR_SCENE_EFFECTS_MAX_BYTES - scene->effects_cached_bytes) {
+		wlr_log(WLR_ERROR, "Backdrop old-plus-candidate/workspace peak budget exceeded");
+		return false;
+	}
+	struct backdrop_cache *cache = calloc(1, sizeof(*cache));
+	if (!cache) {
+		wlr_log(WLR_ERROR, "Cannot allocate backdrop cache");
+		return false;
+	}
+	*cache = (struct backdrop_cache){ .backdrop = backdrop, .output = data->output,
+		.bytes = bytes, .physical = physical, .scale = data->scale,
+		.phase_x = phase_x, .phase_y = phase_y, .dirty = true };
+	wl_list_insert(&backdrop->caches, &cache->link);
+	cache->output_destroy.notify = backdrop_output_destroy;
+	wl_signal_add(&data->output->events.destroy, &cache->output_destroy);
+	scene->effects_cached_bytes += bytes;
+	if (scene->effects_cached_bytes > scene->effects_peak_bytes) {
+		scene->effects_peak_bytes = scene->effects_cached_bytes;
+	}
+	const struct wlr_drm_format *format = wlr_drm_format_set_get(
+		wlr_renderer_get_render_formats(output->renderer), DRM_FORMAT_ARGB8888);
+	struct wlr_buffer *sample = format ? effects_create_buffer(output, width, height, format) : NULL;
+	cache->buffer = format ? effects_create_buffer(output,
+		physical.width, physical.height, format) : NULL;
+	uint32_t *temporary = gles2 ? NULL : malloc((size_t)width * height * 4);
+	float *kernel = malloc(sizeof(float) * (2 * pad + 1));
+	bool ok = sample && cache->buffer && (gles2 || temporary) && kernel;
+	if (ok) {
+		struct wlr_render_pass *pass = wlr_renderer_begin_buffer_pass(output->renderer, sample, NULL);
+		ok = pass != NULL;
+		if (pass) {
+			wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options){
+				.box = {0, 0, width, height}, .color = {.a = 1}, .blend_mode = WLR_RENDER_BLEND_MODE_NONE });
+			bool failed = false;
+			struct render_data lower = *data;
+			lower.render_pass = pass;
+			lower.transform = WL_OUTPUT_TRANSFORM_NORMAL;
+			lower.isolated = true;
+			lower.failed = &failed;
+			lower.buffer_offset_x = physical.x - pad;
+			lower.buffer_offset_y = physical.y - pad;
+			lower.trans_width = width;
+			lower.trans_height = height;
+			pixman_region32_init_rect(&lower.damage, 0, 0, width, height);
+			bool found = backdrop_lower(&scene->tree.node, &rect->node, 0, 0, &lower);
+			pixman_region32_fini(&lower.damage);
+			ok = wlr_render_pass_submit(pass) && found && !failed;
+		}
+	}
+	if (ok) {
+		double sum = 0;
+		for (int i = -pad; i <= pad; i++) {
+			kernel[i + pad] = expf(-(float)(i * i) / (2 * sigma * sigma));
+			sum += kernel[i + pad];
+		}
+		for (int i = 0; i <= 2 * pad; i++) kernel[i] /= sum;
+	}
+	void *source = NULL, *destination = NULL;
+	uint32_t source_format = 0, dest_format = 0;
+	size_t source_stride = 0, dest_stride = 0;
+	bool source_access = !gles2 && ok && wlr_buffer_begin_data_ptr_access(sample, WLR_BUFFER_DATA_PTR_ACCESS_READ,
+		&source, &source_format, &source_stride);
+	bool dest_access = source_access && wlr_buffer_begin_data_ptr_access(cache->buffer,
+		WLR_BUFFER_DATA_PTR_ACCESS_WRITE, &destination, &dest_format, &dest_stride);
+	if (gles2) {
+#if WLR_HAS_GLES2_RENDERER
+		ok = ok && backdrop_gles2_filter(output, sample, cache->buffer, format,
+			width, height, pad, kernel, rect->corner_radius * data->scale, rect->color);
+#else
+		ok = false;
+#endif
+	} else {
+		ok = dest_access && source_format == DRM_FORMAT_ARGB8888 && dest_format == DRM_FORMAT_ARGB8888;
+	}
+	if (ok && !gles2) {
+#if defined(__x86_64__) && defined(__SSE2__)
+		struct scene_effects *effects = scene_effects_from_scene(scene);
+		const struct backdrop_filter_ops *ops = effects->fir_backend == BACKDROP_FIR_EXPERIMENTAL ?
+			&backdrop_experimental_ops : &backdrop_production_ops;
+		if (!effects->fir_path_logged) {
+			wlr_log(WLR_INFO, "Backdrop FIR executing: %s", ops->name);
+			effects->fir_path_logged = true;
+		}
+		struct backdrop_filter_context filter = {
+			.source = source, .destination = destination,
+			.source_stride = source_stride, .dest_stride = dest_stride,
+			.temporary = temporary, .kernel = kernel, .width = width,
+			.height = height, .pad = pad, .physical = physical,
+			.corner_radius = rect->corner_radius, .scale = data->scale, .color = rect->color,
+		};
+		ops->horizontal(&filter);
+		ops->vertical(&filter);
+#else
+		struct scene_effects *effects = scene_effects_from_scene(scene);
+		if (!effects->fir_path_logged) {
+			wlr_log(WLR_INFO, "Backdrop FIR executing: production-single-output");
+			effects->fir_path_logged = true;
+		}
+		for (int py = 0; py < height; py++) {
+			uint32_t *row = (uint32_t *)((uint8_t *)source + py * source_stride);
+			for (int px = pad; px < width - pad; px++) {
+				uint32_t pixel = 0;
+				for (int channel = 0; channel < 32; channel += 8) {
+					float value = 0;
+					for (int i = -pad; i <= pad; i++) {
+						value += ((row[px + i] >> channel) & 255) * kernel[i + pad];
+					}
+					pixel |= (uint32_t)lroundf(value) << channel;
+				}
+				temporary[py * width + px] = pixel;
+			}
+		}
+		for (int py = 0; py < physical.height; py++) {
+			uint32_t *row = (uint32_t *)((uint8_t *)destination + py * dest_stride);
+			for (int px = 0; px < physical.width; px++) {
+				float radius = rect->corner_radius * data->scale;
+				float qx = fabsf(px + 0.5f - physical.width / 2.0f) - physical.width / 2.0f + radius;
+				float qy = fabsf(py + 0.5f - physical.height / 2.0f) - physical.height / 2.0f + radius;
+				float distance = hypotf(fmaxf(qx, 0), fmaxf(qy, 0)) + fminf(fmaxf(qx, qy), 0) - radius;
+				float coverage = radius == 0 ? 1 : fminf(fmaxf(0.5f - distance, 0), 1);
+				uint32_t pixel = 0;
+				for (int channel = 0; channel < 32; channel += 8) {
+					float value = 0;
+					for (int i = -pad; i <= pad; i++) {
+						value += ((temporary[(py + pad + i) * width + px + pad] >> channel) & 255) * kernel[i + pad];
+					}
+					int component = channel == 24 ? 3 : 2 - channel / 8;
+					value = rect->color[component] * 255 + value * (1 - rect->color[3]);
+					pixel |= (uint32_t)lroundf(fminf(value, 255) * coverage) << channel;
+				}
+				row[px] = pixel;
+			}
+		}
+#endif
+	}
+	if (dest_access) {
+		wlr_buffer_end_data_ptr_access(cache->buffer);
+	}
+	if (source_access) {
+		wlr_buffer_end_data_ptr_access(sample);
+	}
+	if (sample) {
+		wlr_buffer_drop(sample);
+	}
+	free(temporary);
+	free(kernel);
+	if (ok) {
+		cache->texture = wlr_texture_from_buffer(output->renderer, cache->buffer);
+		ok = cache->texture != NULL;
+	}
+	if (!ok) {
+		wlr_log(WLR_ERROR, "Regional backdrop allocation/composition/import failed; no fallback");
+		backdrop_cache_destroy(cache);
+		return false;
+	}
+	/* Only the result remains live; the conservative workspace reservation was
+	 * held throughout sampling, filtering, import and old-cache replacement. */
+	size_t retained = (size_t)physical.width * physical.height * 8;
