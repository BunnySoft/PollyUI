+static void rounding_sample(struct wlr_scene_buffer *buffer, int x, int y, void *data) {
+	(void)x;
+	(void)y;
+	struct wlr_scene_output *output = data;
+	struct wlr_scene_output_sample_event event = { .output = output };
+	wl_signal_emit_mutable(&buffer->events.output_sample, &event);
+	if (output->dmabuf_feedback_debounce == 0 && buffer->primary_output == output) {
+		struct wlr_linux_dmabuf_feedback_v1_init_options options = {
+			.main_renderer = output->output->renderer,
+		};
+		scene_buffer_send_dmabuf_feedback(output->scene, buffer, &options);
+	}
+}
+
+static void rounding_render_entry(struct render_list_entry *entry, const struct render_data *data) {
+	struct wlr_scene_tree *tree = wlr_scene_tree_from_node(entry->node);
+	struct scene_rounding_cache *cache = rounding_find_cache(tree->rounding, data->output);
+	assert(cache && cache->texture && !cache->dirty);
+	pixman_region32_t clip;
+	pixman_region32_init(&clip);
+	if (data->isolated) {
+		pixman_region32_union_rect(&clip, &clip, entry->x + tree->rounding->box.x,
+			entry->y + tree->rounding->box.y, tree->rounding->box.width, tree->rounding->box.height);
+	} else {
+		pixman_region32_copy(&clip, &entry->node->visible);
+	}
+	pixman_region32_translate(&clip, -data->logical.x, -data->logical.y);
+	logical_to_buffer_coords(&clip, data, true);
+	pixman_region32_intersect(&clip, &clip, &data->damage);
+	struct wlr_box box = tree->rounding->box;
+	box.x += entry->x - data->logical.x;
+	box.y += entry->y - data->logical.y;
+	transform_output_box(&box, data);
+	wlr_render_pass_add_texture(data->render_pass, &(struct wlr_render_texture_options) {
+		.texture = cache->texture, .dst_box = box,
+		.transform = data->transform, .clip = &clip,
+		.alpha = &tree->rounding->opacity,
+		.blend_mode = WLR_RENDER_BLEND_MODE_PREMULTIPLIED,
+	});
+	pixman_region32_fini(&clip);
+	if (!data->isolated) {
+		wlr_scene_node_for_each_buffer(&tree->node, rounding_sample, data->output);
+	}
+}
+
+bool wlr_scene_tree_prepare_composition(struct wlr_scene_tree *tree) {
+	if (!tree->rounding) {
+		return true;
+	}
+	int x, y;
+	if (!wlr_scene_node_coords(&tree->node, &x, &y)) {
+		return true;
+	}
+	struct wlr_scene *scene = scene_node_get_root(&tree->node);
+	struct wlr_scene_output *output;
+	wl_list_for_each(output, &scene->outputs, link) {
+		if (!output->output->enabled) {
+			continue;
+		}
+		struct wlr_box region = {.x = output->x, .y = output->y};
+		wlr_output_effective_resolution(output->output, &region.width, &region.height);
+		struct wlr_box box = tree->rounding->box, intersection;
+		box.x += x;
+		box.y += y;
+		if (!wlr_box_intersection(&intersection, &box, &region)) {
+			continue;
+		}
+		bool failed = false;
+		struct render_data data = {.output = output, .scale = output->output->scale,
+			.logical = {.x = output->x, .y = output->y}, .failed = &failed};
+		struct render_list_entry entry = {.node = &tree->node, .x = x, .y = y};
+		if (!rounding_prepare(&entry, &data) || failed) {
+			return false;
+		}
+	}
+	return true;
+}
