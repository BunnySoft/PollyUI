cmake_minimum_required(VERSION 3.25)

foreach(argument IN ITEMS PU_DAWN_ROOT PU_DAWN_PLATFORM)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "Required: -D${argument}=...")
    endif()
endforeach()

set(manifest_path "${PU_DAWN_ROOT}/dependency-lock.json")
if(NOT EXISTS "${manifest_path}")
    message(FATAL_ERROR "Dawn distribution gate: missing dependency-lock.json")
endif()
file(READ "${manifest_path}" manifest)

set(source_manifest "${CMAKE_CURRENT_LIST_DIR}/../third_party/dawn-manifest.json")
file(SHA256 "${source_manifest}" expected_manifest_hash)
file(SHA256 "${manifest_path}" actual_manifest_hash)
if(NOT actual_manifest_hash STREQUAL expected_manifest_hash)
    message(FATAL_ERROR "Dawn distribution gate: bundled lock does not match repository manifest")
endif()

string(JSON platform_type TYPE "${manifest}" archives "${PU_DAWN_PLATFORM}")
if(NOT platform_type STREQUAL "OBJECT")
    message(FATAL_ERROR "Dawn distribution gate: unsupported platform '${PU_DAWN_PLATFORM}'")
endif()

string(JSON archive GET "${manifest}" archives "${PU_DAWN_PLATFORM}" file)
string(JSON archive_digest GET "${manifest}" archives "${PU_DAWN_PLATFORM}" sha256)
string(JSON library GET "${manifest}" archives "${PU_DAWN_PLATFORM}" library)
string(JSON library_digest GET "${manifest}" archives "${PU_DAWN_PLATFORM}" librarySha256)
set(library_path "${PU_DAWN_ROOT}/${library}")
if(NOT EXISTS "${library_path}")
    message(FATAL_ERROR "Dawn distribution gate: missing ${library}")
endif()
file(SHA256 "${library_path}" actual_library_digest)
if(NOT actual_library_digest STREQUAL library_digest)
    message(FATAL_ERROR "Dawn distribution gate: checksum mismatch for ${library}")
endif()

string(JSON header_path GET "${manifest}" header path)
string(JSON header_digest GET "${manifest}" header sha256)
if(NOT EXISTS "${PU_DAWN_ROOT}/${header_path}")
    message(FATAL_ERROR "Dawn distribution gate: missing ${header_path}")
endif()
file(READ "${PU_DAWN_ROOT}/${header_path}" header_text)
string(REPLACE "\r\n" "\n" header_text "${header_text}")
string(SHA256 actual_header_digest "${header_text}")
if(NOT actual_header_digest STREQUAL header_digest)
    message(FATAL_ERROR "Dawn distribution gate: checksum mismatch for ${header_path}")
endif()

set(receipt_path "${PU_DAWN_ROOT}/acquisition-receipt.json")
if(NOT EXISTS "${receipt_path}")
    message(FATAL_ERROR "Dawn distribution gate: missing acquisition-receipt.json")
endif()
file(READ "${receipt_path}" receipt)
string(JSON receipt_repository GET "${receipt}" repository)
string(JSON receipt_commit GET "${receipt}" commit)
string(JSON receipt_platform GET "${receipt}" platform)
string(JSON receipt_archive GET "${receipt}" archive)
string(JSON receipt_archive_digest GET "${receipt}" archiveSha256)
string(JSON receipt_library GET "${receipt}" library)
string(JSON receipt_library_digest GET "${receipt}" librarySha256)
string(JSON receipt_header_digest GET "${receipt}" headerSha256LfNormalized)
string(JSON receipt_coverage GET "${receipt}" noticeCoverageComplete)
string(JSON receipt_redistribution_status GET "${receipt}" redistributionStatus)
string(JSON receipt_deployment_status GET "${receipt}" deploymentDecisionStatus)
string(JSON receipt_rights_status GET "${receipt}" rightsConfirmationStatus)
string(JSON repository GET "${manifest}" repository)
string(JSON commit GET "${manifest}" commit)
string(JSON complete GET "${manifest}" noticeCoverage complete)
string(JSON redistribution_status GET "${manifest}" redistributionStatus)
string(JSON deployment_status GET "${manifest}" redistributionReview platforms "${PU_DAWN_PLATFORM}" deploymentDecision)
string(JSON rights_status GET "${manifest}" redistributionReview platforms "${PU_DAWN_PLATFORM}" rightsConfirmation)
if(NOT receipt_repository STREQUAL repository
   OR NOT receipt_commit STREQUAL commit
   OR NOT receipt_header_digest STREQUAL header_digest
   OR NOT receipt_platform STREQUAL PU_DAWN_PLATFORM
   OR NOT receipt_archive STREQUAL archive
   OR NOT receipt_archive_digest STREQUAL archive_digest
   OR NOT receipt_library STREQUAL library
   OR NOT receipt_library_digest STREQUAL library_digest
   OR NOT receipt_coverage STREQUAL complete
   OR NOT receipt_redistribution_status STREQUAL redistribution_status
   OR NOT receipt_deployment_status STREQUAL deployment_status
   OR NOT receipt_rights_status STREQUAL rights_status)
    message(FATAL_ERROR "Dawn distribution gate: acquisition receipt does not match the locked platform artifacts")
endif()

string(JSON license_digest GET "${manifest}" dawnLicenseSha256)
set(license_path "${PU_DAWN_ROOT}/notices/DAWN-LICENSE")
if(NOT EXISTS "${license_path}")
    message(FATAL_ERROR "Dawn distribution gate: missing DAWN-LICENSE")
endif()
file(SHA256 "${license_path}" actual_license_digest)
if(NOT actual_license_digest STREQUAL license_digest)
    message(FATAL_ERROR "Dawn distribution gate: DAWN-LICENSE checksum mismatch")
endif()

string(JSON notice_count LENGTH "${manifest}" thirdPartyNotices)
if(notice_count GREATER 0)
    math(EXPR notice_last "${notice_count}-1")
    foreach(index RANGE 0 ${notice_last})
        string(JSON name GET "${manifest}" thirdPartyNotices ${index} file)
        string(JSON expected_digest GET "${manifest}" thirdPartyNotices ${index} sha256)
        set(notice_path "${PU_DAWN_ROOT}/notices/${name}")
        if(NOT EXISTS "${notice_path}")
            message(FATAL_ERROR "Dawn distribution gate: missing notice ${name}")
        endif()
        file(SHA256 "${notice_path}" actual_digest)
        if(NOT actual_digest STREQUAL expected_digest)
            message(FATAL_ERROR "Dawn distribution gate: checksum mismatch for ${name}")
        endif()
    endforeach()
endif()

if(PU_DAWN_PLATFORM STREQUAL "windows-x86_64")
    foreach(license IN ITEMS LICENSE-LLVM.txt LICENSE-MS.txt)
        string(JSON expected_digest GET "${manifest}" windowsShaderCompiler licenses "${license}")
        set(license_path "${PU_DAWN_ROOT}/notices/DXC-${license}")
        if(NOT EXISTS "${license_path}")
            message(FATAL_ERROR "Dawn distribution gate: missing DXC-${license}")
        endif()
        file(SHA256 "${license_path}" actual_digest)
        if(NOT actual_digest STREQUAL expected_digest)
            message(FATAL_ERROR "Dawn distribution gate: checksum mismatch for DXC-${license}")
        endif()
    endforeach()
    string(JSON additional_license_count LENGTH "${manifest}" windowsShaderCompiler additionalLicenseFiles)
    if(additional_license_count GREATER 0)
        math(EXPR additional_license_last "${additional_license_count}-1")
        foreach(index RANGE 0 ${additional_license_last})
            string(JSON staged_file GET "${manifest}" windowsShaderCompiler additionalLicenseFiles ${index} stagedFile)
            string(JSON expected_digest GET "${manifest}" windowsShaderCompiler additionalLicenseFiles ${index} sha256)
            set(license_path "${PU_DAWN_ROOT}/notices/${staged_file}")
            if(NOT EXISTS "${license_path}")
                message(FATAL_ERROR "Dawn distribution gate: missing ${staged_file}")
            endif()
            file(SHA256 "${license_path}" actual_digest)
            if(NOT actual_digest STREQUAL expected_digest)
                message(FATAL_ERROR "Dawn distribution gate: checksum mismatch for ${staged_file}")
            endif()
        endforeach()
    endif()
    foreach(dll IN ITEMS dxcompiler.dll dxil.dll)
        string(JSON expected_digest GET "${manifest}" windowsShaderCompiler runtimeFiles "${dll}")
        set(runtime_path "${PU_DAWN_ROOT}/runtime/${dll}")
        if(NOT EXISTS "${runtime_path}")
            message(FATAL_ERROR "Dawn distribution gate: missing runtime/${dll}")
        endif()
        file(SHA256 "${runtime_path}" actual_digest)
        if(NOT actual_digest STREQUAL expected_digest)
            message(FATAL_ERROR "Dawn distribution gate: checksum mismatch for runtime/${dll}")
        endif()
    endforeach()
endif()

if(NOT complete)
    string(JSON remaining_count LENGTH "${manifest}" noticeCoverage remaining)
    set(remaining_text "")
    if(remaining_count GREATER 0)
        math(EXPR remaining_last "${remaining_count}-1")
        foreach(index RANGE 0 ${remaining_last})
            string(JSON remaining_item GET "${manifest}" noticeCoverage remaining ${index})
            string(APPEND remaining_text "${remaining_item}; ")
        endforeach()
    endif()
    message(FATAL_ERROR
        "Dawn distribution gate: technical notice closure is incomplete: ${remaining_text}")
endif()
if(NOT deployment_status STREQUAL "approved")
    message(FATAL_ERROR
        "Dawn distribution gate: deployment decision for ${PU_DAWN_PLATFORM} must be 'approved', got '${deployment_status}'")
endif()
if(NOT rights_status STREQUAL "confirmed")
    message(FATAL_ERROR
        "Dawn distribution gate: rights confirmation for ${PU_DAWN_PLATFORM} must be 'confirmed', got '${rights_status}'")
endif()
if(NOT redistribution_status STREQUAL "approved")
    message(FATAL_ERROR
        "Dawn distribution gate: redistributionStatus must be 'approved', got '${redistribution_status}'")
endif()

message(STATUS "Dawn distribution gate passed for ${PU_DAWN_PLATFORM}")
