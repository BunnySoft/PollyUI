+static struct backdrop_cache *backdrop_find(struct wlr_scene_backdrop *backdrop,
+		struct wlr_scene_output *output) {
+	struct backdrop_cache *cache;
+	wl_list_for_each(cache, &backdrop->caches, link) {
+		if (cache->output == output) {
+			return cache;
+		}
+	}
+	return NULL;
+}
