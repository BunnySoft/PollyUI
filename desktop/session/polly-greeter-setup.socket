[Unit]
Description=Restricted local first-run password setup socket
# Account preparation is ordered by the broker and greeter, after basic.target.

[Socket]
ListenStream=/run/polly-greeter/setup.sock
SocketUser=polly-greeter
SocketGroup=polly-greeter
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
