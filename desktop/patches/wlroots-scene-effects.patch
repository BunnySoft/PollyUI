+	glDepthFunc(depth_function);
+	glDepthMask(write_depth);
+	GLenum error = glGetError();
+	pop_gles2_debug(renderer);
+	if (error != GL_NO_ERROR) {
+		wlr_log(WLR_ERROR, "Projected texture rendering failed: GL error 0x%x", error);
+		pass->failed = true;
+		return false;
+	}
+	return true;
 }
 
