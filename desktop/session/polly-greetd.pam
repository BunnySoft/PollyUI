#%PAM-1.0
auth requisite pam_succeed_if.so user = polly uid = 1000 quiet
auth requisite pam_exec.so quiet seteuid /usr/sbin/polly-accounts check
auth required pam_unix.so
auth required pam_nologin.so
account requisite pam_succeed_if.so user = polly uid = 1000 quiet
account requisite pam_exec.so quiet seteuid /usr/sbin/polly-accounts check
account required pam_unix.so
account required pam_nologin.so
session required pam_loginuid.so
session optional pam_keyinit.so force revoke
session required pam_systemd.so type=wayland
