+static bool backdrop_preflight(struct wlr_scene_rect *rect) {
+	struct wlr_scene_output *output;
+	wl_list_for_each(output, &rect->backdrop->scene->outputs, link) {
+		if (!output->output->enabled) {
+			continue;
+		}
+		bool failed = false;
+		struct render_data data = {.output = output, .scale = output->output->scale,
+			.logical = {.x = output->x, .y = output->y}, .failed = &failed};
+		int x, y, width, height;
+		wlr_scene_node_coords(&rect->node, &x, &y);
+		wlr_output_effective_resolution(output->output, &width, &height);
+		struct wlr_box region = {output->x, output->y, width, height};
+		struct wlr_box box = {x, y, rect->width, rect->height}, intersection;
+		if (wlr_box_intersection(&intersection, &box, &region) && !backdrop_prepare(rect, &data)) {
+			return false;
+		}
+	}
+	return true;
+}
