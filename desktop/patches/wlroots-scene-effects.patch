+	glBindTexture(GL_TEXTURE_2D, texture->tex);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glUniform1i(renderer->shaders.projected.tex, 0);
+	glUniform1f(renderer->shaders.projected.opacity, options->opacity);
+	glUniform4fv(renderer->shaders.projected.background, 1, options->background);
+	const GLfloat texcoords[] = {0, 0, 1, 0, 0, 1, 1, 1};
+	glVertexAttribPointer(renderer->shaders.projected.position, 4, GL_FLOAT, GL_FALSE, 0, options->vertices);
+	glVertexAttribPointer(renderer->shaders.projected.texcoord, 2, GL_FLOAT, GL_FALSE, 0, texcoords);
+	glEnableVertexAttribArray(renderer->shaders.projected.position);
+	glEnableVertexAttribArray(renderer->shaders.projected.texcoord);
