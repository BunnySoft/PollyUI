+/* Traverse the scene, not the visibility-culled output list: an upper opaque
+ * node must not erase lower pixels needed by an earlier backdrop's kernel. */
+static bool backdrop_lower(struct wlr_scene_node *node, struct wlr_scene_node *stop,
+		int x, int y, const struct render_data *data) {
+	if (node == stop) {
+		return true;
+	}
+	if (!node->enabled) {
+		return false;
+	}
+	x += node->x;
+	y += node->y;
+	struct render_list_entry entry = { .node = node, .x = x, .y = y };
+	if (node->type == WLR_SCENE_NODE_TREE) {
+		struct wlr_scene_tree *tree = wlr_scene_tree_from_node(node);
+		if (tree->rounding) {
+			if (!rounding_prepare(&entry, data)) {
+				*data->failed = true;
+			} else {
+				rounding_render_entry(&entry, data);
+			}
+			return false;
+		}
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &tree->children, link) {
+			if (backdrop_lower(child, stop, x, y, data)) {
+				return true;
+			}
+		}
+	} else {
+		int width, height;
+		scene_node_get_size(node, &width, &height);
+		struct wlr_box box = {x - data->logical.x, y - data->logical.y, width, height};
+		scale_box(&box, data->scale);
+		struct wlr_box region = {data->buffer_offset_x, data->buffer_offset_y,
+			data->trans_width, data->trans_height}, intersection;
+		if (wlr_box_intersection(&intersection, &box, &region)) {
+			if (node->type == WLR_SCENE_NODE_RECT && wlr_scene_rect_from_node(node)->backdrop &&
+					!backdrop_prepare(wlr_scene_rect_from_node(node), data)) {
+				*data->failed = true;
+			} else {
+				scene_entry_render(&entry, data);
+			}
+		}
+	}
+	return false;
+}
+
+static bool backdrop_prepare(struct wlr_scene_rect *rect, const struct render_data *data) {
+	struct wlr_scene_backdrop *backdrop = rect->backdrop;
+	struct wlr_scene *scene = backdrop->scene;
+	struct wlr_output *output = data->output->output;
+	int x, y;
+	wlr_scene_node_coords(&rect->node, &x, &y);
+	struct wlr_box physical = {x - data->logical.x, y - data->logical.y, rect->width, rect->height};
+	scale_box(&physical, data->scale);
+	float phase_x = (x - data->logical.x) * data->scale - physical.x;
+	float phase_y = (y - data->logical.y) * data->scale - physical.y;
+	struct backdrop_cache *old = backdrop_find(backdrop, data->output);
+	if (old && !old->dirty && old->scale == data->scale &&
+			old->phase_x == phase_x && old->phase_y == phase_y && wlr_box_equal(&physical, &old->physical)) {
+		return true;
+	}
+	float sigma = backdrop->sigma * data->scale;
+	int pad = ceilf(3 * sigma);
+	int width = physical.width + pad * 2, height = physical.height + pad * 2;
+	if (!wlr_scene_backdrop_supported(output->renderer) || !isfinite(sigma) || sigma > 64 ||
+			physical.width <= 0 || physical.height <= 0 ||
