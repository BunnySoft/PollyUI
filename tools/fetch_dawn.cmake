cmake_minimum_required(VERSION 3.25)
foreach(argument IN ITEMS PU_DAWN_PLATFORM PU_DAWN_DEST)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "Required: -D${argument}=...")
    endif()
endforeach()
if(NOT DEFINED PU_DAWN_CACHE)
    set(PU_DAWN_CACHE "${CMAKE_CURRENT_LIST_DIR}/../.cache/dawn")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../third_party/dawn-manifest.json" manifest)
string(JSON repository GET "${manifest}" repository)
string(JSON tag GET "${manifest}" tag)
string(JSON commit GET "${manifest}" commit)
string(JSON archive GET "${manifest}" archives "${PU_DAWN_PLATFORM}" file)
string(JSON archive_digest GET "${manifest}" archives "${PU_DAWN_PLATFORM}" sha256)
file(MAKE_DIRECTORY "${PU_DAWN_CACHE}" "${PU_DAWN_DEST}/notices")

function(fetch_verified url path digest)
    if(NOT EXISTS "${path}")
        file(DOWNLOAD "${url}" "${path}.partial"
            EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON
            TIMEOUT 120 INACTIVITY_TIMEOUT 30 STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${path}.partial")
            message(FATAL_ERROR "Cannot fetch pinned dependency: ${status}")
        endif()
        file(RENAME "${path}.partial" "${path}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL digest)
        message(FATAL_ERROR "Native dependency checksum mismatch: ${path}")
    endif()
endfunction()

fetch_verified("https://github.com/${repository}/releases/download/${tag}/${archive}"
    "${PU_DAWN_CACHE}/${archive}" "${archive_digest}")
file(ARCHIVE_EXTRACT INPUT "${PU_DAWN_CACHE}/${archive}" DESTINATION "${PU_DAWN_DEST}")
string(REGEX REPLACE "\\.tar\\.gz$" "" package_directory "${archive}")
string(JSON library GET "${manifest}" archives "${PU_DAWN_PLATFORM}" library)
string(JSON library_digest GET "${manifest}" archives "${PU_DAWN_PLATFORM}" librarySha256)
file(SHA256 "${PU_DAWN_DEST}/${package_directory}/${library}" actual_library_digest)
if(NOT actual_library_digest STREQUAL library_digest)
    message(FATAL_ERROR "Dawn static library checksum mismatch: ${library}")
endif()
file(COPY "${PU_DAWN_DEST}/${package_directory}/include" DESTINATION "${PU_DAWN_DEST}")
if(EXISTS "${PU_DAWN_DEST}/${package_directory}/lib64")
    file(COPY "${PU_DAWN_DEST}/${package_directory}/lib64" DESTINATION "${PU_DAWN_DEST}")
else()
    file(COPY "${PU_DAWN_DEST}/${package_directory}/lib" DESTINATION "${PU_DAWN_DEST}")
endif()
string(JSON header GET "${manifest}" header path)
string(JSON header_digest GET "${manifest}" header sha256)
file(READ "${PU_DAWN_DEST}/${header}" header_text)
string(REPLACE "\r\n" "\n" header_text "${header_text}")
string(SHA256 actual "${header_text}")
if(NOT actual STREQUAL header_digest)
    message(FATAL_ERROR "Dawn header fingerprint mismatch")
endif()
string(JSON license_digest GET "${manifest}" dawnLicenseSha256)
fetch_verified("https://raw.githubusercontent.com/${repository}/${commit}/LICENSE"
    "${PU_DAWN_DEST}/notices/DAWN-LICENSE" "${license_digest}")
string(JSON notice_count LENGTH "${manifest}" thirdPartyNotices)
if(notice_count GREATER 0)
    math(EXPR notice_last "${notice_count}-1")
    foreach(index RANGE 0 ${notice_last})
        string(JSON name GET "${manifest}" thirdPartyNotices ${index} file)
        string(JSON url GET "${manifest}" thirdPartyNotices ${index} url)
        string(JSON notice_digest GET "${manifest}" thirdPartyNotices ${index} sha256)
        fetch_verified("${url}" "${PU_DAWN_DEST}/notices/${name}" "${notice_digest}")
    endforeach()
endif()

if(PU_DAWN_PLATFORM STREQUAL "windows-x86_64")
    string(JSON dxc_repository GET "${manifest}" windowsShaderCompiler repository)
    string(JSON dxc_tag GET "${manifest}" windowsShaderCompiler tag)
    string(JSON dxc_archive GET "${manifest}" windowsShaderCompiler file)
    string(JSON dxc_archive_digest GET "${manifest}" windowsShaderCompiler sha256)
    fetch_verified("https://github.com/${dxc_repository}/releases/download/${dxc_tag}/${dxc_archive}"
        "${PU_DAWN_CACHE}/${dxc_archive}" "${dxc_archive_digest}")
    file(ARCHIVE_EXTRACT INPUT "${PU_DAWN_CACHE}/${dxc_archive}" DESTINATION "${PU_DAWN_CACHE}/dxc")
    file(MAKE_DIRECTORY "${PU_DAWN_DEST}/runtime")
    foreach(dll IN ITEMS dxcompiler.dll dxil.dll)
        file(COPY_FILE "${PU_DAWN_CACHE}/dxc/bin/x64/${dll}" "${PU_DAWN_DEST}/runtime/${dll}" ONLY_IF_DIFFERENT)
        string(JSON runtime_digest GET "${manifest}" windowsShaderCompiler runtimeFiles "${dll}")
        file(SHA256 "${PU_DAWN_DEST}/runtime/${dll}" actual)
        if(NOT actual STREQUAL runtime_digest)
            message(FATAL_ERROR "DXC runtime checksum mismatch: ${dll}")
        endif()
    endforeach()
    foreach(license IN ITEMS LICENSE-LLVM.txt LICENSE-MS.txt)
        string(JSON dxc_license_digest GET "${manifest}" windowsShaderCompiler licenses "${license}")
        file(SHA256 "${PU_DAWN_CACHE}/dxc/${license}" actual)
        if(NOT actual STREQUAL dxc_license_digest)
            message(FATAL_ERROR "DXC license checksum mismatch: ${license}")
        endif()
        file(COPY_FILE "${PU_DAWN_CACHE}/dxc/${license}" "${PU_DAWN_DEST}/notices/DXC-${license}")
    endforeach()
    string(JSON additional_license_count LENGTH "${manifest}" windowsShaderCompiler additionalLicenseFiles)
    if(additional_license_count GREATER 0)
        math(EXPR additional_license_last "${additional_license_count}-1")
        foreach(index RANGE 0 ${additional_license_last})
            string(JSON archive_path GET "${manifest}" windowsShaderCompiler additionalLicenseFiles ${index} archivePath)
            string(JSON staged_file GET "${manifest}" windowsShaderCompiler additionalLicenseFiles ${index} stagedFile)
            string(JSON additional_license_digest GET "${manifest}" windowsShaderCompiler additionalLicenseFiles ${index} sha256)
            set(source_path "${PU_DAWN_CACHE}/dxc/${archive_path}")
            if(NOT EXISTS "${source_path}")
                message(FATAL_ERROR "DXC original notice missing from pinned archive: ${archive_path}")
            endif()
            file(SHA256 "${source_path}" actual)
            if(NOT actual STREQUAL additional_license_digest)
                message(FATAL_ERROR "DXC original notice checksum mismatch: ${archive_path}")
            endif()
            file(COPY_FILE "${source_path}" "${PU_DAWN_DEST}/notices/${staged_file}")
        endforeach()
    endif()
endif()
file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../third_party/dawn-manifest.json"
    "${PU_DAWN_DEST}/dependency-lock.json")
set(PU_DAWN_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/../third_party/dawn-manifest.json")
include("${CMAKE_CURRENT_LIST_DIR}/write_dawn_acquisition_receipt.cmake")
message(STATUS "Verified native Dawn dependency: ${PU_DAWN_DEST}")
message(STATUS "Not redistributable yet: complete bundled third-party notices before packaging")
