#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
chmod 0755 /
mkdir -p /proc /sys /dev /run /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
echo "PollyDesktop Live: memory-only root; no block-device installation." >/dev/console
case " $(cat /proc/cmdline) " in
    *" polly.serial=1 "*)
        if [ -f /etc/conf.d/syslog ]; then
            sed -i 's|SYSLOGD_OPTS=.*|SYSLOGD_OPTS="-O /dev/ttyS0"|' /etc/conf.d/syslog
        else
            mkdir -p /run/systemd/journald.conf.d
            printf '[Journal]\nForwardToConsole=yes\nTTYPath=/dev/ttyS0\n' > /run/systemd/journald.conf.d/polly-serial.conf
        fi
        ;;
esac
exec /sbin/init
